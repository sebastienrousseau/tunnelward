#
# Formula for the sebastienrousseau/tap Homebrew tap. Pre-built per-arch
# binaries from the signed, SLSA-attested GitHub Release. Rendered by
# scripts/render-formula.sh; do not edit the rendered copy by hand.
class Tunnelward < Formula
  desc "Serve AI agents from behind a firewall with no inbound port"
  homepage "https://github.com/sebastienrousseau/tunnelward"
  license "GPL-3.0-only"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/sebastienrousseau/tunnelward/releases/download/v@VERSION@/tunnelward-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_AARCH64_APPLE_DARWIN@"
    else
      url "https://github.com/sebastienrousseau/tunnelward/releases/download/v@VERSION@/tunnelward-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/sebastienrousseau/tunnelward/releases/download/v@VERSION@/tunnelward-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_AARCH64_UNKNOWN_LINUX_MUSL@"
    else
      url "https://github.com/sebastienrousseau/tunnelward/releases/download/v@VERSION@/tunnelward-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  def install
    bin.install "tunnelward"
  end

  test do
    assert_match "tunnelward #{version}", shell_output("#{bin}/tunnelward --version")
  end
end
